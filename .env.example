# Env vars are prefixed with SOCIAFLUX_ so they do not collide with other
# projects that share Vercel team-level variables.

# Turso (libSQL). Leave both unset to use a local SQLite file at .data/sociaflux.db
SOCIAFLUX_TURSO_DATABASE_URL=""
SOCIAFLUX_TURSO_AUTH_TOKEN=""

# "mock" uses the built-in heuristic analysis engine; "openai" calls the API.
SOCIAFLUX_AI_PROVIDER="mock"
SOCIAFLUX_OPENAI_API_KEY=""
SOCIAFLUX_OPENAI_MODEL="gpt-4o-mini"

# Optional. Defaults to "SociaFlux" when unset.
NEXT_PUBLIC_SOCIAFLUX_PRODUCT_NAME=""

# Instagram API with Instagram Login (Meta app -> Instagram -> API setup with
# Instagram login). Without these, the Connect Instagram button is disabled and
# creators enter their numbers by hand.
SOCIAFLUX_INSTAGRAM_APP_ID=""
SOCIAFLUX_INSTAGRAM_APP_SECRET=""
SOCIAFLUX_INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/auth/instagram/callback"

# Instagram Business Discovery. Lets the server read public metrics for *any*
# public professional account (Cristiano, Messi, Sony...) through one account
# that you own, so creators do not have to log in to be analysed.
# Unlike the variables above this uses Facebook Login, not Instagram Login:
# run `npm run ig:setup` to get the user id and verify the token.
SOCIAFLUX_INSTAGRAM_DISCOVERY_TOKEN=""
SOCIAFLUX_INSTAGRAM_DISCOVERY_USER_ID=""

# The Meta app's own credentials (App settings > Basic). Only used by
# `npm run ig:token` to turn a short-lived Explorer token into a permanent Page
# token. Different from SOCIAFLUX_INSTAGRAM_APP_ID, which is the "IG App ID".
SOCIAFLUX_FACEBOOK_APP_ID=""
SOCIAFLUX_FACEBOOK_APP_SECRET=""
